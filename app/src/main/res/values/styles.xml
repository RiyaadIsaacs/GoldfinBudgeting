<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="GoldfinBadgeTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">145dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/badge_tile_locked</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:textColor">#1E1E1E</item>
        <item name="android:textSize">16sp</item>
        <item name="android:clickable">false</item>
    </style>

    <style name="GoldfinBadgeNavTab">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">14sp</item>
        <item name="android:background">@drawable/profile_gold_tab</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
