<?xml version="1.0" encoding="utf-8"?>

<!--basically the same as the edit envelopes layout-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android = "http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id = "@+id/drawerLayout"
    android:layout_width = "match_parent"
    android:layout_height = "match_parent">

    <!--same as edit envelopes screen-->
    <LinearLayout
        android:id="@+id/main"
        android:layout_width = "match_parent"
        android:layout_height = "match_parent"
        android:orientation = "vertical"
        android:background = "#EEEEEE">

        <!--top bar of screen-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:gravity = "center_vertical"
            android:paddingStart = "16dp"
            android:paddingEnd = "16dp"
            android:background = "#F5F5F5">

            <TextView
                android:id = "@+id/menuIcon"
                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "☰"
                android:textSize = "24sp"
                android:textColor = "#333333"
                android:clickable = "true"
                android:focusable = "true"/>

            <TextView
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Expenses"
                android:textSize = "18sp"
                android:textColor = "#333333"/>

            <TextView
                android:id = "@+id/logOutButton"
                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "Log Out"
                android:textSize = "14sp"
                android:textColor = "#333333"
                android:clickable = "true"
                android:focusable = "true"/>

        </LinearLayout>

        <!--cancel and add buttons row-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "wrap_content"
            android:orientation = "horizontal"
            android:gravity = "center_vertical"
            android:paddingStart = "20dp"
            android:paddingEnd = "20dp"
            android:paddingTop = "16dp"
            android:paddingBottom = "16dp"
            android:background = "#D8D0E0">

            <TextView
                android:id = "@+id/cancelButton"
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight = "1"
                android:text = "Cancel"
                android:textSize = "18sp"
                android:textStyle = "bold"
                android:textColor = "#C9A200"
                android:clickable = "true"
                android:focusable = "true" />

            <TextView
                android:id = "@+id/addButton"
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight = "1"
                android:gravity = "end"
                android:text = "Add"
                android:textSize = "18sp"
                android:textStyle = "bold"
                android:textColor = "#C9A200"
                android:clickable = "true"
                android:focusable ="true" />

        </LinearLayout>

        <!--scrollable content section-->
        <ScrollView
            android:layout_width = "match_parent"
            android:layout_height = "0dp"
            android:layout_weight = "1">

            <LinearLayout
                android:layout_width = "match_parent"
                android:layout_height = "wrap_content"
                android:orientation = "vertical">

                <!--select form section-->
                <LinearLayout
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:orientation = "vertical"
                    android:background = "#FFFFFF"
                    android:padding = "20dp">

                    <!--entry name input field-->
                    <TextView
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:text = "Entry Name"
                        android:textSize = "12sp"
                        android:textColor = "#888888"/>

                    <EditText
                        android:id = "@+id/entryNameEditText"
                        android:layout_width = "match_parent"
                        android:layout_height = "48dp"
                        android:layout_marginTop = "6dp"
                        android:layout_marginBottom = "16dp"
                        android:hint = "e.g. Comic Con Tickets"
                        android:paddingStart = "16dp"
                        android:paddingEnd = "16dp"
                        android:background = "@drawable/rounded_input_field"
                        android:textSize = "14sp"/>

                    <!--amount input field-->
                    <TextView
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:text = "Amount (R)"
                        android:textSize = "12sp"
                        android:textColor = "#888888"/>

                    <EditText
                        android:id = "@+id/amountEditText"
                        android:layout_width = "match_parent"
                        android:layout_height = "48dp"
                        android:layout_marginTop = "6dp"
                        android:layout_marginBottom = "16dp"
                        android:hint = "0.00"
                        android:inputType = "numberDecimal"
                        android:paddingStart = "16dp"
                        android:paddingEnd = "16dp"
                        android:background = "@drawable/rounded_input_field"
                        android:textSize = "14sp"/>

                    <!--date input field-->
                    <TextView
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:text = "Date"
                        android:textSize = "12sp"
                        android:textColor = "#888888"/>

                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "48dp"
                        android:layout_marginTop = "6dp"
                        android:layout_marginBottom = "16dp"
                        android:orientation = "horizontal"
                        android:gravity = "center_vertical"
                        android:background = "@drawable/rounded_input_field"
                        android:paddingStart = "16dp"
                        android:paddingEnd = "16dp">

                        <EditText
                            android:id = "@+id/dateEditText"
                            android:layout_width = "0dp"
                            android:layout_height = "match_parent"
                            android:layout_weight = "1"
                            android:text = "2026/08/14"
                            android:background = "@android:color/transparent"
                            android:textSize = "14sp"/>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "calender here"
                            android:textSize = "18sp"/>

                    </LinearLayout>

                    <!--start time and end time row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "horizontal"
                        android:layout_marginBottom = "16dp">

                        <LinearLayout
                            android:layout_width = "0dp"
                            android:layout_height = "wrap_content"
                            android:layout_weight = "1"
                            android:layout_marginEnd = "8dp"
                            android:orientation = "vertical">

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Start Time"
                                android:textSize = "12sp"
                                android:textColor = "#888888"/>

                            <EditText
                                android:id = "@+id/startTimeEditText"
                                android:layout_width = "match_parent"
                                android:layout_height = "48dp"
                                android:layout_marginTop = "6dp"
                                android:text = "09:00"
                                android:gravity = "center"
                                android:background = "@drawable/rounded_input_field"
                                android:textSize = "14sp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width = "0dp"
                            android:layout_height = "wrap_content"
                            android:layout_weight = "1"
                            android:orientation = "vertical">

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "End Time"
                                android:textSize = "12sp"
                                android:textColor = "#888888"/>

                            <EditText
                                android:id = "@+id/endTimeEditText"
                                android:layout_width = "match_parent"
                                android:layout_height = "48dp"
                                android:layout_marginTop = "6dp"
                                android:text = "17:00"
                                android:gravity = "center"
                                android:background = "@drawable/rounded_input_field"
                                android:textSize = "14sp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <!--description input field-->
                    <TextView
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:text = "Description"
                        android:textSize = "12sp"
                        android:textColor = "#888888"/>

                    <EditText
                        android:id = "@+id/descriptionEditText"
                        android:layout_width = "match_parent"
                        android:layout_height = "48dp"
                        android:layout_marginTop = "6dp"
                        android:layout_marginBottom = "16dp"
                        android:hint = "Optional notes"
                        android:paddingStart = "16dp"
                        android:paddingEnd = "16dp"
                        android:background = "@drawable/rounded_input_field"
                        android:textSize = "14sp"/>

                    <!--category input field-->
                    <TextView
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:text = "Category"
                        android:textSize = "12sp"
                        android:textColor = "#888888"/>

                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "48dp"
                        android:layout_marginTop = "6dp"
                        android:layout_marginBottom = "16dp"
                        android:orientation = "horizontal"
                        android:gravity = "center_vertical"
                        android:background = "@drawable/rounded_input_field"
                        android:paddingStart = "16dp"
                        android:paddingEnd = "16dp"
                        android:clickable = "true"
                        android:focusable = "true">

                        <TextView
                            android:layout_width = "0dp"
                            android:layout_height = "wrap_content"
                            android:layout_weight = "1"
                            android:text = "General"
                            android:textSize = "14sp"
                            android:textColor = "#333333"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text = "icon"
                            android:textSize = "20sp"
                            android:textColor = "#333333"/>

                    </LinearLayout>

                    <!--receipt photo attach input field-->
                    <TextView
                        android:layout_width = "wrap_content"
                        android:layout_height = "wrap_content"
                        android:text = "Receipt Photo (Optional)"
                        android:textSize = "12sp"
                        android:textColor = "#888888"/>

                    <LinearLayout
                        android:layout_width = "80dp"
                        android:layout_height = "80dp"
                        android:layout_marginTop = "6dp"
                        android:orientation = "vertical"
                        android:gravity = "center"
                        android:background = "@drawable/rounded_dashed_border"
                        android:clickable = "true"
                        android:focusable = "true">

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Image here"
                            android:textSize = "20sp"/>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:layout_marginTop = "4dp"
                            android:text = "Tap to attach"
                            android:textSize = "10sp"
                            android:textColor = "#888888"
                            android:gravity = "center"/>

                    </LinearLayout>

                </LinearLayout>

                <!--expense list section-->
                <LinearLayout
                    android:layout_width = "match_parent"
                    android:layout_height = "wrap_content"
                    android:orientation = "vertical"
                    android:background = "#FFFFFF"
                    android:paddingStart = "20dp"
                    android:paddingEnd = "20dp">

                    <!--expense row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "vertical"
                        android:paddingTop = "12dp"
                        android:paddingBottom = "12dp">

                        <LinearLayout
                            android:layout_width = "match_parent"
                            android:layout_height = "wrap_content"
                            android:orientation = "horizontal">

                            <TextView
                                android:layout_width = "0dp"
                                android:layout_height = "wrap_content"
                                android:layout_weight = "1"
                                android:text = "Call of Duty 3"
                                android:textSize = "16sp"
                                android:textStyle = "bold"
                                android:textColor = "#333333"/>

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Delete"
                                android:textSize = "14sp"
                                android:textColor = "#E64A19"
                                android:clickable = "true"
                                android:focusable = "true"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Games -> 5 Aug"
                            android:textSize = "12sp"
                            android:textStyle = "italic"
                            android:textColor = "#888888"/>

                    </LinearLayout>

                    <View
                        android:layout_width = "match_parent"
                        android:layout_height = "1dp"
                        android:background = "#EEEEEE"/>

                    <!--another eexpense row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "vertical"
                        android:paddingTop = "12dp"
                        android:paddingBottom = "12dp">

                        <LinearLayout
                            android:layout_width = "match_parent"
                            android:layout_height = "wrap_content"
                            android:orientation = "horizontal">

                            <TextView
                                android:layout_width = "0dp"
                                android:layout_height = "wrap_content"
                                android:layout_weight = "1"
                                android:text = "McDonalds"
                                android:textSize = "16sp"
                                android:textStyle = "bold"
                                android:textColor = "#333333"/>

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Delete"
                                android:textSize = "14sp"
                                android:textColor = "#E64A19"
                                android:clickable = "true"
                                android:focusable = "true"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Takeouts -> 6 Aug"
                            android:textSize = "12sp"
                            android:textStyle = "italic"
                            android:textColor = "#888888"/>

                    </LinearLayout>

                    <View
                        android:layout_width = "match_parent"
                        android:layout_height = "1dp"
                        android:background = "#EEEEEE"/>

                    <!--another expense row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "vertical"
                        android:paddingTop = "12dp"
                        android:paddingBottom = "12dp">

                        <LinearLayout
                            android:layout_width = "match_parent"
                            android:layout_height = "wrap_content"
                            android:orientation = "horizontal">

                            <TextView
                                android:layout_width = "0dp"
                                android:layout_height = "wrap_content"
                                android:layout_weight = "1"
                                android:text = "Spiderman: Brand New Day"
                                android:textSize = "16sp"
                                android:textStyle = "bold"
                                android:textColor = "#333333"/>

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Delete"
                                android:textSize = "14sp"
                                android:textColor = "#E64A19"
                                android:clickable = "true"
                                android:focusable = "true"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Entertainment -> 7 Aug"
                            android:textSize = "12sp"
                            android:textStyle = "italic"
                            android:textColor = "#888888"/>

                    </LinearLayout>

                    <View
                        android:layout_width = "match_parent"
                        android:layout_height = "1dp"
                        android:background = "#EEEEEE"/>

                    <!--another expense row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "vertical"
                        android:paddingTop = "12dp"
                        android:paddingBottom = "12dp">

                        <LinearLayout
                            android:layout_width = "match_parent"
                            android:layout_height = "wrap_content"
                            android:orientation = "horizontal">

                            <TextView
                                android:layout_width = "0dp"
                                android:layout_height = "wrap_content"
                                android:layout_weight = "1"
                                android:text = "Astron Energy"
                                android:textSize = "16sp"
                                android:textStyle = "bold"
                                android:textColor = "#333333"/>

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Delete"
                                android:textSize = "14sp"
                                android:textColor = "#E64A19"
                                android:clickable = "true"
                                android:focusable = "true"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Car -> 8 Aug"
                            android:textSize = "12sp"
                            android:textStyle = "italic"
                            android:textColor = "#888888" />

                    </LinearLayout>

                    <View
                        android:layout_width = "match_parent"
                        android:layout_height = "1dp"
                        android:background = "#EEEEEE" />

                    <!--another expense row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "vertical"
                        android:paddingTop = "12dp"
                        android:paddingBottom = "12dp">

                        <LinearLayout
                            android:layout_width = "match_parent"
                            android:layout_height = "wrap_content"
                            android:orientation = "horizontal">

                            <TextView
                                android:layout_width = "0dp"
                                android:layout_height = "wrap_content"
                                android:layout_weight = "1"
                                android:text = "Netflix subscription"
                                android:textSize = "16sp"
                                android:textStyle = "bold"
                                android:textColor = "#333333"/>

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Delete"
                                android:textSize = "14sp"
                                android:textColor = "#E64A19"
                                android:clickable = "true"
                                android:focusable = "true"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Subscriptions -> 1 Aug"
                            android:textSize = "12sp"
                            android:textStyle = "italic"
                            android:textColor = "#888888"/>

                    </LinearLayout>

                    <View
                        android:layout_width = "match_parent"
                        android:layout_height = "1dp"
                        android:background = "#EEEEEE"/>

                    <!--another expense row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "vertical"
                        android:paddingTop = "12dp"
                        android:paddingBottom = "12dp">

                        <LinearLayout
                            android:layout_width = "match_parent"
                            android:layout_height = "wrap_content"
                            android:orientation = "horizontal">

                            <TextView
                                android:layout_width = "0dp"
                                android:layout_height = "wrap_content"
                                android:layout_weight = "1"
                                android:text = "Kauai"
                                android:textSize = "16sp"
                                android:textStyle = "bold"
                                android:textColor = "#333333"/>

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Delete"
                                android:textSize = "14sp"
                                android:textColor = "#E64A19"
                                android:clickable = "true"
                                android:focusable = "true"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Takeouts -> 10 Aug"
                            android:textSize = "12sp"
                            android:textStyle = "italic"
                            android:textColor = "#888888"/>

                    </LinearLayout>

                    <View
                        android:layout_width = "match_parent"
                        android:layout_height = "1dp"
                        android:background = "#EEEEEE"/>

                    <!--another expense row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "vertical"
                        android:paddingTop = "12dp"
                        android:paddingBottom = "12dp">

                        <LinearLayout
                            android:layout_width = "match_parent"
                            android:layout_height = "wrap_content"
                            android:orientation = "horizontal">

                            <TextView
                                android:layout_width = "0dp"
                                android:layout_height = "wrap_content"
                                android:layout_weight = "1"
                                android:text = "Comic Warehouse"
                                android:textSize = "16sp"
                                android:textStyle = "bold"
                                android:textColor = "#333333"/>

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Delete"
                                android:textSize = "14sp"
                                android:textColor = "#E64A19"
                                android:clickable = "true"
                                android:focusable = "true"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Entertainment -> 12 Aug"
                            android:textSize = "12sp"
                            android:textStyle = "italic"
                            android:textColor = "#888888"/>

                    </LinearLayout>

                    <View
                        android:layout_width = "match_parent"
                        android:layout_height = "1dp"
                        android:background = "#EEEEEE"/>

                    <!--another expense row-->
                    <LinearLayout
                        android:layout_width = "match_parent"
                        android:layout_height = "wrap_content"
                        android:orientation = "vertical"
                        android:paddingTop = "12dp"
                        android:paddingBottom = "12dp">

                        <LinearLayout
                            android:layout_width = "match_parent"
                            android:layout_height = "wrap_content"
                            android:orientation = "horizontal">

                            <TextView
                                android:layout_width = "0dp"
                                android:layout_height = "wrap_content"
                                android:layout_weight = "1"
                                android:text = "Typo"
                                android:textSize = "16sp"
                                android:textStyle = "bold"
                                android:textColor = "#333333"/>

                            <TextView
                                android:layout_width = "wrap_content"
                                android:layout_height = "wrap_content"
                                android:text = "Delete"
                                android:textSize = "14sp"
                                android:textColor = "#E64A19"
                                android:clickable = "true"
                                android:focusable = "true"/>

                        </LinearLayout>

                        <TextView
                            android:layout_width = "wrap_content"
                            android:layout_height = "wrap_content"
                            android:text = "Groceries -> 14 Aug"
                            android:textSize = "12sp"
                            android:textStyle = "italic"
                            android:textColor = "#888888"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!--bottom navigation bar-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:background = "@drawable/rounded_bottom_nav">

            <TextView
                android:id = "@+id/profileTab"
                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Profile"
                android:clickable = "true"
                android:focusable = "true"
                android:textSize = "14sp"
                android:textColor = "#000000"/>

            <TextView
                android:id = "@+id/homeTab"
                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Home"
                android:textSize = "14sp"
                android:textColor = "#000000"
                android:clickable = "true"
                android:focusable = "true"/>

            <TextView
                android:id = "@+id/expensesTab"
                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Expenses"
                android:textSize = "14sp"
                android:textStyle = "bold"
                android:textColor = "#000000"
                android:clickable = "true"
                android:focusable = "true"/>

        </LinearLayout>

    </LinearLayout>

    <!--side menu drawer. burger icon-->
    <LinearLayout
        android:layout_width = "260dp"
        android:layout_height = "match_parent"
        android:layout_gravity = "start"
        android:orientation = "vertical"
        android:background = "#F5F0FA">

        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:gravity = "center_vertical"
            android:paddingStart = "16dp"
            android:paddingEnd = "16dp"
            android:background = "#D8D0E0">

            <TextView
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "GoldFin"
                android:textSize = "20sp"
                android:textStyle = "bold"
                android:textColor = "#C9A200"/>

            <TextView
                android:id = "@+id/closeDrawerButton"
                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "X"
                android:textSize = "20sp"
