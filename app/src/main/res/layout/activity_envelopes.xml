<?xml version="1.0" encoding="utf-8"?>

<!--same as the home screen xml but though the summary amount. uses recycleview-->

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android = "http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id = "@+id/drawerLayout"
    android:layout_width = "match_parent"
    android:layout_height = "match_parent">

    <LinearLayout
        android:id = "@+id/main"

        android:layout_width = "match_parent"
        android:layout_height = "match_parent"
        android:orientation = "vertical"
        android:background = "#EEEEEE">

        <!--top bar of screen that has burger icon, title and log out-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:gravity = "center_vertical"
            android:paddingStart = "16dp"
            android:paddingEnd = "16dp"
            android:background = "#F5F5F5">

            <TextView
                android:id = "@+id/menuIcon"

                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "☰"
                android:textSize = "24sp"
                android:textColor = "#333333"
                android:clickable = "true"
                android:focusable = "true"/>

            <TextView
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Envelopes"
                android:textSize = "18sp"
                android:textColor = "#333333"/>

            <TextView
                android:id = "@+id/logOutButton"
                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "Log Out"
                android:textSize = "14sp"
                android:textColor = "#333333"
                android:clickable = "true"
                android:focusable = "true"/>

        </LinearLayout>

        <!--content area where filter row is fixed. Envelope list expands and scrolls by itself-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "0dp"
            android:layout_weight = "1"
            android:orientation = "vertical"
            android:padding = "16dp">

            <!--date filer and edit button rows at top-->
            <LinearLayout
                android:layout_width = "match_parent"
                android:layout_height = "wrap_content"
                android:orientation = "horizontal"
                android:gravity = "center_vertical">

                <TextView
                    android:id = "@+id/monthFilterButton"
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:paddingStart = "20dp"
                    android:paddingEnd = "20dp"
                    android:paddingTop = "10dp"
                    android:paddingBottom = "10dp"
                    android:text = "August 2026"
                    android:textSize = "14sp"
                    android:textStyle = "bold"
                    android:textColor = "#FFFFFF"
                    android:background = "@drawable/rounded_button_gold"
                    android:clickable = "true"
                    android:focusable = "true"/>

                <View
                    android:layout_width = "0dp"
                    android:layout_height = "1dp"
                    android:layout_weight = "1"/>

                <TextView
                    android:id = "@+id/editEnvelopesButton"
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:paddingStart = "20dp"
                    android:paddingEnd = "20dp"
                    android:paddingTop = "10dp"
                    android:paddingBottom = "10dp"
                    android:text = "Edit Envelopes"
                    android:textSize = "14sp"
                    android:textStyle = "bold"
                    android:textColor = "#FFFFFF"
                    android:background = "@drawable/rounded_button_gold"/>

            </LinearLayout>

            <!--envelope cards. scrolls on own. not using scrollview-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/envelopeRecyclerView"

                android:layout_width = "match_parent"
                android:layout_height = "0dp"
                android:layout_weight = "1"
                android:layout_marginTop = "16dp"
                android:clipToPadding = "false"
                android:paddingBottom = "16dp"/>

        </LinearLayout>

        <!--bottom navigation section-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:background = "@drawable/rounded_bottom_nav">

            <TextView
                android:id = "@+id/profileTab"
                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Profile"
                android:textSize = "14sp"
                android:textColor = "#000000"/>

            <TextView
                android:id = "@+id/homeTab"

                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Home"
                android:textSize = "14sp"
                android:textColor = "#000000"
                android:clickable = "true"
                android:focusable = "true"/>

            <TextView
                android:id = "@+id/expensesTab"

                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Expenses"
                android:textSize = "14sp"
                android:textColor = "#000000"
                android:clickable = "true"
                android:focusable = "true"/>

        </LinearLayout>

    </LinearLayout>

    <!--side drawer menu. hamburger icon-->
    <LinearLayout
        android:layout_width = "260dp"
        android:layout_height = "match_parent"
        android:layout_gravity = "start"
        android:orientation = "vertical"
        android:background = "#F5F0FA">

        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:gravity = "center_vertical"
            android:paddingStart = "16dp"
            android:paddingEnd = "16dp"
            android:background = "#D8D0E0">

            <TextView
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "GoldFin"
                android:textSize = "20sp"
                android:textStyle = "bold"
                android:textColor = "#C9A200"/>

            <TextView
                android:id = "@+id/closeDrawerButton"

                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "X"
                android:textSize = "20sp"
                android:textColor = "#555555"
                android:clickable = "true"
                android:focusable = "true"/>

        </LinearLayout>

        <TextView
            android:id = "@+id/envelopesMenuItem"

            android:layout_width = "match_parent"
            android:layout_height = "48dp"
            android:gravity = "center"
            android:text = "Envelopes"
            android:textSize = "16sp"
            android:textColor = "#4B0082"
            android:background = "#E6DDF5"
            android:clickable = "true"
            android:focusable = "true"/>

        <TextView
            android:layout_width = "match_parent"
            android:layout_height = "48dp"
            android:layout_marginTop = "1dp"
            android:gravity = "center"
            android:text = "Accounts"
            android:textSize = "16sp"
            android:textColor = "#333333"
            android:background = "#EDE5F7"
            android:clickable = "true"
            android:focusable = "true"/>

        <TextView
            android:layout_width = "match_parent"
            android:layout_height = "48dp"
            android:layout_marginTop = "1dp"
            android:gravity = "center"
            android:text = "Badges"
            android:textSize = "16sp"
            android:textColor = "#333333"
            android:background = "#E6DDF5"
            android:clickable = "true"
            android:focusable = "true"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>