<?xml version="1.0" encoding="utf-8"?>

<!--Profile Screen - Version 2 from Figma. White 412 x 917 frame translated to a full phone screen.-->

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <!--Rectangle 1 top bar: #F7F2FA with shadow-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="11dp"
            android:paddingEnd="0dp"
            android:background="#F7F2FA"
            android:elevation="4dp">

            <TextView
                android:id="@+id/menuIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:gravity="center"
                android:text="☰"
                android:textSize="22sp"
                android:textColor="#1E1E1E"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Profile"
                android:textSize="20sp"
                android:textColor="#1E1E1E"/>

            <!--Tab 8 in the Figma file sits in the top bar as Log Out-->
            <TextView
                android:id="@+id/logOutButton"
                android:layout_width="103dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="Log Out"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:background="#F7F2FA"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFFF"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/profileContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <!--gold ring + generic avatar-->
                <FrameLayout
                    android:layout_width="205dp"
                    android:layout_height="205dp"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/profile_gold_ring"
                    android:elevation="4dp">

                    <View
                        android:layout_width="175dp"
                        android:layout_height="175dp"
                        android:layout_gravity="center"
                        android:background="@drawable/profile_ring_inner"/>

                    <LinearLayout
                        android:layout_width="135dp"
                        android:layout_height="135dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:background="@drawable/profile_avatar_circle"
                        android:elevation="3dp">

                        <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/ic_profile_person"
                            android:contentDescription="Profile avatar"/>

                    </LinearLayout>

                </FrameLayout>

                <!--MyName heading-->
                <TextView
                    android:id="@+id/displayNameHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="MyName"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <!--Display Name field sits above the grey card-->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="Display Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="21dp"
                        android:layout_height="21dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_profile_edit"
                        android:contentDescription="Edit display name"/>

                    <EditText
                        android:id="@+id/displayNameEditText"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:background="@drawable/profile_input"
                        android:textSize="16sp"
                        android:textColor="#1E1E1E"
                        android:hint="Enter name"
                        android:inputType="textPersonName"/>

                    <TextView
                        android:id="@+id/saveDisplayNameButton"
                        android:layout_width="61dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:gravity="center"
                        android:text="Save"
                        android:textSize="16sp"
                        android:textColor="#F5F5F5"
                        android:background="@drawable/profile_save_button"
                        android:elevation="4dp"
                        android:clickable="true"
                        android:focusable="true"/>

                </LinearLayout>

                <!--Rectangle 3 grey card holding email, mobile, and settings-->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="28dp"
                    android:background="@drawable/profile_gray_card">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/emailEditText"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@drawable/profile_input"
                            android:textSize="16sp"
                            android:textColor="#1E1E1E"
                            android:hint="Enter email"
                            android:inputType="textEmailAddress"/>

                        <TextView
                            android:id="@+id/saveEmailButton"
                            android:layout_width="61dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:gravity="center"
                            android:text="Save"
                            android:textSize="16sp"
                            android:textColor="#F5F5F5"
                            android:background="@drawable/profile_save_button"
                            android:elevation="4dp"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="Mobile Number"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#000000"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <EditText
                            android:id="@+id/mobileEditText"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@drawable/profile_input"
                            android:textSize="16sp"
                            android:textColor="#1E1E1E"
                            android:hint="Enter number"
                            android:inputType="phone"/>

                        <TextView
                            android:id="@+id/saveMobileButton"
                            android:layout_width="61dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="12dp"
                            android:gravity="center"
                            android:text="Save"
                            android:textSize="16sp"
                            android:textColor="#F5F5F5"
                            android:background="@drawable/profile_save_button"
                            android:elevation="4dp"
                            android:clickable="true"
                            android:focusable="true"/>

                    </LinearLayout>

                    <!--Security Policy Button-->
                    <LinearLayout
                        android:id="@+id/securityPolicyButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="28dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/profile_settings_row"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="23dp"
                            android:layout_height="23dp"
                            android:src="@drawable/ic_profile_shield"
                            android:contentDescription="Security policy"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="Security Policy"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#5E5E5E"/>

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_profile_chevron"
                            android:contentDescription="Open security policy"/>

                    </LinearLayout>

                    <!--Account Settings Button-->
                    <LinearLayout
                        android:id="@+id/accountSettingsButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:background="@drawable/profile_settings_row"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_profile_settings"
                            android:contentDescription="Account settings"/>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="13dp"
                            android:text="Account Settings"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#5E5E5E"/>

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:src="@drawable/ic_profile_chevron"
                            android:contentDescription="Open account settings"/>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <!--bottom tabs from the Figma file: Profile, Home, Expenses-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:id="@+id/profileTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Profile"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.007"
                android:textColor="#000000"
                android:background="@drawable/profile_gold_tab"/>

            <TextView
                android:id="@+id/homeTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Home"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.007"
                android:textColor="#000000"
                android:background="@drawable/profile_gold_tab"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/expensesTab"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Expenses"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="0.007"
                android:textColor="#000000"
                android:background="@drawable/profile_gold_tab"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

    </LinearLayout>

    <!--side drawer menu-->
    <LinearLayout
        android:layout_width="260dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#F5F0FA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="#D8D0E0">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="GoldFin"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#C9A200"/>

            <TextView
                android:id="@+id/closeDrawerButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X"
                android:textSize="20sp"
                android:textColor="#555555"
                android:clickable="true"
                android:focusable="true"/>

        </LinearLayout>

        <TextView
            android:id="@+id/envelopesMenuItem"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="Envelopes"
            android:textSize="16sp"
            android:textColor="#4B0082"
            android:background="#E6DDF5"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:text="Accounts"
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="#EDE5F7"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:text="Badges"
            android:textSize="16sp"
            android:textColor="#333333"
            android:background="#E6DDF5"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
