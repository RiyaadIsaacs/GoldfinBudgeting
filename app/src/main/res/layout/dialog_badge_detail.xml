<?xml version="1.0" encoding="utf-8"?>

<!-- centered popup when an unlocked badge is tapped -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="#FFFFFF">

    <FrameLayout
        android:layout_width="148dp"
        android:layout_height="145dp"
        android:layout_gravity="center_horizontal">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/badge_tile_unlocked"/>

        <ImageView
            android:id="@+id/badgePopupIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:contentDescription="Unlocked badge"
            android:src="@drawable/ic_badge_star"/>

    </FrameLayout>

    <TextView
        android:id="@+id/badgePopupTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="Badge name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1E1E1E"/>

    <TextView
        android:id="@+id/badgePopupRequirement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Unlock requirement"
        android:textSize="14sp"
        android:textColor="#555555"/>

    <TextView
        android:id="@+id/badgePopupCloseButton"
        android:layout_width="140dp"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="Close"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/rounded_button_gold"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
