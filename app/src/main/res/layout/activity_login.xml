<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp"
    android:background="#FFFFFF">

    <!--image placement for the GoldFin logo. get image from drawable folder (res -> drawable)-->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/goldfin_logo"
        android:contentDescription="GoldFin logo"/>

    <!--text for app title-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="GoldFin"
        android:textSize="40sp"
        android:textColor="#888888"
        android:textStyle="bold"/>

    <!--space separation between title and inputs-->
    <Space
        android:layout_width="match_parent"
        android:layout_height="40dp"/>

    <!--text for email heading-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email: "
        android:textSize="16sp" />

    <!--input field for email address-->
    <EditText
        android:id="@+id/emailEditText"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:hint="Enter email address here..."
        android:inputType="textEmailAddress"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/rounded_edittext"
        android:textSize="16sp" />

    <!--text for email heading-->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Password: "
        android:textSize="16sp"/>

    <!--input field for password-->
    <EditText
        android:id="@+id/passwordEditText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:hint="Enter password here..."
        android:inputType="textPassword"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/rounded_edittext"
        android:textSize="16sp"
        android:textColor="#000000"
        android:textColorHint="#999999"/>

    <!--space separation for between input fields and button-->
    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp"/>

    <!--app sign in button-->
    <Button
        android:id="@+id/signInButton"
        android:layout_width="100dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Sign In"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:background="@drawable/rounded_button_gold"
        app:backgroundTint="@null" />

</LinearLayout>