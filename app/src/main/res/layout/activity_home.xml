<?xml version="1.0" encoding="utf-8"?>

<!--this used to be hardcoded. now the category cards are dynamic via EnvelopeAdapter and EnvelopeTempMemory-->

<!--drawer layout for hamburger icon-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android = "http://schemas.android.com/apk/res/android"
    xmlns:app = "http://schemas.android.com/apk/res-auto"
    android:id = "@+id/drawerLayout"
    android:layout_width = "match_parent"
    android:layout_height = "match_parent">

    <!--main screen content-->
    <LinearLayout
        android:id = "@+id/main"

        android:layout_width = "match_parent"
        android:layout_height = "match_parent"
        android:orientation = "vertical"
        android:background = "#EEEEEE">

        <!--top bar with home title and logout button and hamburger icon-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:gravity = "center_vertical"
            android:paddingStart = "16dp"
            android:paddingEnd = "16dp"
            android:background = "#F5F5F5">

            <!--hamburger menu icon-->
            <TextView
                android:id = "@+id/menuIcon"

                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "☰"
                android:textSize = "24sp"
                android:textColor = "#333333"
                android:clickable = "true"
                android:focusable = "true"/>

            <!--home button-->
            <TextView
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight="1"
                android:gravity = "center"
                android:text = "Home"
                android:textSize = "18sp"
                android:textColor = "#333333"/>

            <!--log out button-->
            <TextView
                android:id = "@+id/logOutButton"

                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "Log Out"
                android:textSize = "14sp"
                android:textColor = "#333333"
                android:clickable = "true"
                android:focusable = "true"/>

        </LinearLayout>

        <!--content area. gold card fixed in place. category list scrolls on its own. not in ScrollView anymore so recyclerView can resize when item is added-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "0dp"
            android:layout_weight = "1"
            android:orientation = "vertical"
            android:padding = "16dp">

            <!--total spent card at top of screen-->
            <LinearLayout
                android:layout_width = "match_parent"
                android:layout_height = "wrap_content"
                android:layout_marginBottom = "16dp"
                android:orientation = "vertical"
                android:padding = "24dp"
                android:background = "@drawable/rounded_card_gold">

                <!--total spending text title-->
                <TextView
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:text = "Total Spent This Month:"
                    android:textSize = "18sp"
                    android:textStyle = "bold"
                    android:textColor = "#000000"/>

                <!--amount spent text. still hardcoded, not linked to envelope data yet-->
                <TextView
                    android:layout_width = "wrap_content"
                    android:layout_height = "wrap_content"
                    android:layout_marginTop = "8dp"
                    android:layout_gravity = "center_horizontal"
                    android:text = "R 3700"
                    android:textSize = "34sp"
                    android:textStyle = "bold"
                    android:textColor = "#000000"/>

            </LinearLayout>

            <!--category cardd. filled dynamically using EnvelopeAdapter-->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/envelopeRecyclerView"

                android:layout_width = "match_parent"
                android:layout_height = "0dp"
                android:layout_weight = "1"
                android:clipToPadding = "false"
                android:paddingBottom = "16dp"/>

        </LinearLayout>

        <!--bottom navigation bar-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:background = "@drawable/rounded_bottom_nav">

            <TextView
                android:id = "@+id/profileTab"

                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Profile"
                android:textSize = "14sp"
                android:textColor = "#000000"
                android:clickable = "true"
                android:focusable = "true"/>

            <TextView
                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Home"
                android:textSize = "14sp"
                android:textStyle = "bold"
                android:textColor = "#000000"/>

            <TextView
                android:id = "@+id/expensesTab"

                android:layout_width = "0dp"
                android:layout_height = "match_parent"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "Expenses"
                android:textSize = "14sp"
                android:textColor = "#000000"
                android:clickable = "true"
                android:focusable = "true"/>

        </LinearLayout>

    </LinearLayout>

    <!--side draw layout-->
    <LinearLayout
        android:layout_width = "260dp"
        android:layout_height = "match_parent"
        android:layout_gravity = "start"
        android:orientation = "vertical"
        android:background = "#F5F0FA">

        <!--header for side bar drawout-->
        <LinearLayout
            android:layout_width = "match_parent"
            android:layout_height = "56dp"
            android:orientation = "horizontal"
            android:gravity = "center_vertical"
            android:paddingStart = "16dp"
            android:paddingEnd = "16dp"
            android:background = "#D8D0E0">

            <TextView
                android:layout_width = "0dp"
                android:layout_height = "wrap_content"
                android:layout_weight = "1"
                android:gravity = "center"
                android:text = "GoldFin"
                android:textSize = "20sp"
                android:textStyle = "bold"
                android:textColor = "#C9A200"/>

            <TextView
                android:id = "@+id/closeDrawerButton"

                android:layout_width = "wrap_content"
                android:layout_height = "wrap_content"
                android:text = "X"
                android:textSize = "20sp"
                android:textColor = "#555555"
                android:clickable = "true"
                android:focusable = "true"/>

        </LinearLayout>

        <!--envelopes menu item in side menu-->
        <TextView
            android:id = "@+id/envelopesMenuItem"

            android:layout_width = "match_parent"
            android:layout_height = "48dp"
            android:gravity = "center"
            android:text = "Envelopes"
            android:textSize = "16sp"
            android:textColor = "#4B0082"
            android:background = "#E6DDF5"
            android:clickable = "true"
            android:focusable = "true"/>

        <!--accounts menu item in side menu-->
        <TextView
            android:layout_width = "match_parent"
            android:layout_height = "48dp"
            android:layout_marginTop = "1dp"
            android:gravity = "center"
            android:text = "Accounts"
            android:textSize = "16sp"
            android:textColor = "#333333"
            android:background = "#EDE5F7"
            android:clickable = "true"
            android:focusable = "true"/>

        <!--badges menu item in side menu-->
        <TextView
            android:layout_width = "match_parent"
            android:layout_height = "48dp"
            android:layout_marginTop = "1dp"
            android:gravity = "center"
            android:text = "Badges"
            android:textSize = "16sp"
            android:textColor = "#333333"
            android:background = "#E6DDF5"
            android:clickable = "true"
            android:focusable = "true"/>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>



