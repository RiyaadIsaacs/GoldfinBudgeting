<?xml version="1.0" encoding="utf-8"?>

<!--
    Create Account screen layout
    Same style as login with email create password and confirm password
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp"
    android:background="#FFFFFF">

    <!-- logo at the top -->
    <ImageView
        android:id="@+id/logo"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/goldfin_logo"
        android:contentDescription="GoldFin logo"/>

    <!-- app title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="GoldFin"
        android:textSize="40sp"
        android:textColor="#888888"
        android:textStyle="bold"/>

    <!-- space before the form fields -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="40dp"/>

    <!-- Email -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Email: "
        android:textSize="16sp" />

    <EditText
        android:id="@+id/emailEditText"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="6dp"
        android:hint="Enter email address..."
        android:inputType="textEmailAddress"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/rounded_edittext"
        android:textSize="16sp" />

    <!-- Create password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Create Password: "
        android:textSize="16sp"/>

    <EditText
        android:id="@+id/passwordEditText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:hint="Enter password..."
        android:inputType="textPassword"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/rounded_edittext"
        android:textSize="16sp"
        android:textColor="#000000"
        android:textColorHint="#999999"/>

    <!-- Confirm password -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Confirm Password: "
        android:textSize="16sp"/>

    <EditText
        android:id="@+id/confirmPasswordEditText"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="6dp"
        android:hint="Retype password..."
        android:inputType="textPassword"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/rounded_edittext"
        android:textSize="16sp"
        android:textColor="#000000"
        android:textColorHint="#999999"/>

    <!-- space before the buttons -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp"/>

    <!-- saves the new account into Room -->
    <Button
        android:id="@+id/createAccountButton"
        android:layout_width="160dp"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="Create Account"
        android:textSize="14sp"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:background="@drawable/rounded_button_gold"
        app:backgroundTint="@null" />

    <!-- goes back to the login screen without creating an account -->
    <Button
        android:id="@+id/backToLoginButton"
        android:layout_width="120dp"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:text="Back"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:background="@drawable/rounded_button_gold"
        app:backgroundTint="@null" />

</LinearLayout>
