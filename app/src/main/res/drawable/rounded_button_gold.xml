<?xml version="1.0" encoding="utf-8"?>

<!--
    Gold button background
    Uses a selector so the button looks slightly darker while pressed
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- finger is down on the button -->
    <item
        android:state_pressed="true"
        android:drawable="@drawable/rounded_button_gold_pressed"/>

    <!-- normal look when not pressed -->
    <item android:drawable="@drawable/rounded_button_gold_normal"/>

</selector>
